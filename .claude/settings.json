{
  "permissions": {
    "deny": [
      "Bash(git add -A)",
      "Bash(git add -A:*)",
      "Bash(git add .)",
      "Bash(git add .:*)",
      "Bash(git add -u)",
      "Bash(git add -u:*)",
      "Bash(git add --all)",
      "Bash(git add --all:*)",
      "Bash(git add --update)",
      "Bash(git add --update:*)",
      "Bash(rm -rf:*)",
      "Edit(.env*)",
      "Read(.env*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/Scripts/reinstall-if-stale.sh",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
