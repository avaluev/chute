<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- An appex is sandboxed whether or not you ask; declaring it is what makes the ad-hoc
       signature acceptable to pluginkit. Measured: without this, registration silently fails. -->
  <key>com.apple.security.app-sandbox</key><true/>
  <!-- Finder only. The extension no longer drives Terminal or runs git — it writes a request and
       ChuteApp does the work — so asking for those entitlements bought nothing and is one more
       thing macOS can refuse. -->
  <key>com.apple.security.automation.apple-events</key><array><string>com.apple.finder</string></array>
  <key>com.apple.security.temporary-exception.apple-events</key><array><string>com.apple.finder</string></array>
  <!-- Writing the request file into ~/.chute/requests, which is outside the container. Scoped to
       that one directory: the absolute-path form was `/` — a read-write exception on the entire
       filesystem for a process that only ever writes one folder. home-relative is the right shape
       here because the path is `~/.chute` and the username is not known at build time
       (`ActionRequest.swift:26`). -->
  <key>com.apple.security.temporary-exception.files.home-relative-path.read-write</key><array><string>/.chute/</string></array>
</dict>
</plist>
